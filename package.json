{
  "name": "tableos",
  "version": "0.16.8",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel --filter=@tableos/server --filter=@tableos/web --filter=@tableos/public",
    "dogfood": "node scripts/dogfood.mjs",
    "version:set": "node scripts/version.mjs",
    "dev:api": "pnpm --filter @tableos/server dev",
    "dev:realtime": "pnpm --filter @tableos/server dev:realtime",
    "dev:worker": "pnpm --filter @tableos/server dev:worker",
    "dev:relay": "pnpm --filter @tableos/server dev:relay",
    "dev:web": "pnpm --filter @tableos/web dev",
    "dev:public": "pnpm --filter @tableos/public dev",
    "db:migrate": "pnpm --filter @tableos/db migrate",
    "db:seed": "pnpm --filter @tableos/db seed",
    "test:e2e": "pnpm --filter @tableos/web test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  }
}
