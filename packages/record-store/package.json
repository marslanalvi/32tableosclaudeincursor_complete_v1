{
  "name": "@tableos/record-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "tableos": {
    "tier": "T2b",
    "env": "isomorphic"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
